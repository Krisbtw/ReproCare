+    // Hard gate 4: FIGO classification compatibility
+    const candFigoNum = parsePrimaryFigoNumber(cand.figo ?? cand.locationLabel);
+    if (repFigoNum != null && candFigoNum != null && Math.abs(repFigoNum - candFigoNum) >= 2) {
+      incompatibilityReasons.push(
+        `Incompatible FIGO classification (report: FIGO ${ef.figo}, candidate ${cand.findingCode}: FIGO ${cand.figo ?? candFigoNum})`,
+      );
+    }
