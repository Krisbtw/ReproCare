+        seriesId: String(sRows[0].id),
+        seriesInstanceUid: sRows[0].series_instance_uid ? String(sRows[0].series_instance_uid) : null,
+        seriesNumber: sRows[0].series_number != null ? Number(sRows[0].series_number) : null,
+        description: sRows[0].description ? String(sRows[0].description) : null,
+        plane: sRows[0].plane ? String(sRows[0].plane) : null,
+        sliceCount: sRows[0].slice_count != null ? Number(sRows[0].slice_count) : null,
