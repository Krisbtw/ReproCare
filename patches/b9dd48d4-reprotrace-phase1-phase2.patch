+function hasContradictoryAnatomicalLocation(
+  locA: string | null | undefined,
+  locB: string | null | undefined,
+): string | null {
+  if (!locA || !locB) return null;
+  const a = locA.toLowerCase();
+  const b = locB.toLowerCase();
+  const pairs: Array<[RegExp, RegExp, string, string]> = [
+    [/\banterior\b/, /\bposterior\b/, "anterior", "posterior"],
+    [/\bfundal|fundus\b/, /\bcervical|cervix\b/, "fundal", "cervical"],
+    [/\bsubmucosal\b/, /\bsubserosal\b/, "submucosal", "subserosal"],
+    [/\bleft\b/, /\bright\b/, "left", "right"],
+  ];
+  for (const [re1, re2, label1, label2] of pairs) {
+    if ((re1.test(a) && re2.test(b)) || (re2.test(a) && re1.test(b))) {
+      return `Anatomical location conflict (${label1} vs ${label2})`;
+    }
