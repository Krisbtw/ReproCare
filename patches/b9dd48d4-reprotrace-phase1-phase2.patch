+    if (incompatibilityReasons.length > 0) {
+      return {
+        findingId: cand.findingId,
+        findingCode: cand.findingCode,
+        findingVersionId: cand.findingVersionId,
+        versionNo: cand.versionNo,
+        studyId: cand.studyId,
+        observedOn: cand.observedOn,
+        organ: cand.organ,
+        structure: cand.structure,
+        locationLabel: cand.locationLabel,
+        laterality: candLat,
+        figo: cand.figo,
+        longestMm: cand.longestMm,
+        volumeMm3: cand.volumeMm3,
+        frame: cand.frame,
+        compatible: false,
+        score: 0,
+        reasons: [],
+        incompatibilityReasons,
+        explanation: `Incompatible with ${cand.findingCode} (${cand.locationLabel}): ${incompatibilityReasons.join("; ")}.`,
+      };
+    }
