+    extractedFinding: ef,
+    measurements,
+    candidates,
+  } = input;
+
+  const linkedMeasurements = (ef.measurementIndexes ?? [])
+    .map((idx) => measurements[idx])
+    .filter((m): m is ExtractedMeasurement => Boolean(m));
+
+  const lengthMeas = linkedMeasurements.find((m) => m.dimension === "length");
+  const volumeMeas = linkedMeasurements.find((m) => m.dimension === "volume");
+
+  const reportedLongestMm = lengthMeas ? longestMm(lengthMeas) : null;
