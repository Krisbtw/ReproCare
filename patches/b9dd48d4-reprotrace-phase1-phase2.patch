+  return {
+    findingIndex,
+    structure: ef.structure,
+    organ: ef.organ,
+    laterality: ef.laterality,
+    anatomicalLocation: ef.anatomicalLocation ?? null,
+    figo: ef.figo,
+    reportedLongestMm,
+    reportedVolumeMm3,
+    dimensionKind,
+    candidateState: state,
+    candidateStateLabel: CANDIDATE_STATE_LABELS[state],
+    suggestedFindingId: best.findingId,
+    suggestedVersionId: best.findingVersionId,
+    requiresClinicianConfirmation: true,
+    summaryExplanation: best.explanation,
+    candidates: scoredCandidates,
+  };
