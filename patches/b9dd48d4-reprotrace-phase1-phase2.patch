+    }
+
+    // Hard gate 2: Organ & structure compatibility
+    const organCompat =
+      cand.organ.toLowerCase() === ef.organ.toLowerCase() ||
+      ef.organ.toLowerCase() === "pelvis" ||
+      cand.organ.toLowerCase() === "pelvis";
+    if (!organCompat) {
+      incompatibilityReasons.push(
+        `Organ mismatch (report: ${ef.organ}, candidate ${cand.findingCode}: ${cand.organ})`,
+      );
+    }
+
+    const structCompat = structuresCompatible(ef.structure, cand.structure);
+    if (!structCompat) {
+      incompatibilityReasons.push(
+        `Finding type mismatch (report: ${ef.structure}, candidate ${cand.findingCode}: ${cand.structure})`,
+      );
+    }
+
+    // Hard gate 3: Laterality compatibility
+    const candLat = extractLateralityFromText(cand.locationLabel);
+    const repLat = ef.laterality ?? extractLateralityFromText(ef.anatomicalLocation);
+    if (
+      repLat &&
+      candLat &&
+      repLat !== "bilateral" &&
+      candLat !== "bilateral" &&
+      repLat !== candLat
