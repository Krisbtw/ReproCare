+-- 0015: ReproTrace Phase 1 & Phase 2 — Complete Anatomical Evidence Linking, Source-to-Anatomy Provenance, and Cross-Examination Correspondence Metadata.
+-- Safe, additive, backward-compatible migration preserving all existing records and append-only audit tables.
+
+-- 1. Extend evidence_links with complete source-to-anatomy provenance fields and explicit evidence_link_status
+alter table evidence_links add column if not exists extraction_id text;
+alter table evidence_links add column if not exists extraction_version integer default 1;
+alter table evidence_links add column if not exists page_number integer default 1;
+alter table evidence_links add column if not exists extraction_provenance text default 'explicitly_stated';
+alter table evidence_links add column if not exists review_status text default 'unreviewed';
+alter table evidence_links add column if not exists reviewed_by text;
+alter table evidence_links add column if not exists review_decision text;
+alter table evidence_links add column if not exists finding_id text;
+alter table evidence_links add column if not exists sop_instance_uid text;
+alter table evidence_links add column if not exists frame_number integer;
+alter table evidence_links add column if not exists coordinate_frame text;
+alter table evidence_links add column if not exists centroid_lps_mm text;
+alter table evidence_links add column if not exists registration_id text;
+alter table evidence_links add column if not exists source_artifact_id text;
+alter table evidence_links add column if not exists evidence_link_status text default 'report_only';
+alter table evidence_links add column if not exists created_at timestamptz;
+
+create index if not exists idx_evidence_links_report_id on evidence_links (report_id);
+create index if not exists idx_evidence_links_finding_id on evidence_links (finding_id);
+create index if not exists idx_evidence_links_status on evidence_links (evidence_link_status);
+
+-- 2. Extend report_finding_reviews with explicit workflow action and evidence link reference
+alter table report_finding_reviews add column if not exists workflow_action text;
+alter table report_finding_reviews add column if not exists evidence_link_id text;
+alter table report_finding_reviews add column if not exists evidence_link_status text;
+
+-- 3. Extend correspondences with origin_source ('seeded' vs 'computed'), registration_status, and registration_id
+alter table correspondences add column if not exists origin_source text default 'computed';
+alter table correspondences add column if not exists registration_status text;
+alter table correspondences add column if not exists registration_id text;
