+  if (plausible.length === 0) {
+    const whyNone =
+      scoredCandidates.length === 0
+        ? "No existing anatomical findings are recorded for this patient."
+        : `None of the ${scoredCandidates.length} existing finding(s) are anatomically compatible (${scoredCandidates.map((c) => `${c.findingCode}: ${c.incompatibilityReasons.join(", ")}`).join(" | ")}).`;
