+    // Weighted deterministic score for compatible candidate
+    let score = 0.30; // Base score for compatible patient + organ + structure
+    reasons.push(`Matching organ (${cand.organ}) and finding type (${cand.structure})`);
+
+    // Study & exam date alignment (max +0.20)
+    if (reportStudyId && cand.studyId === reportStudyId) {
+      score += 0.20;
+      reasons.push(`Belongs to the same imaging examination (${cand.observedOn})`);
+    } else if (reportExamDate && cand.observedOn.slice(0, 10) === reportExamDate.slice(0, 10)) {
+      score += 0.18;
+      reasons.push(`Matches examination date (${reportExamDate.slice(0, 10)})`);
+    } else {
+      score += 0.08;
+      reasons.push(`Prior/longitudinal examination version (${cand.observedOn.slice(0, 10)})`);
+    }
+
+    // Location & laterality specificity (max +0.20)
+    const repLoc = (ef.anatomicalLocation ?? "").toLowerCase();
+    const candLoc = cand.locationLabel.toLowerCase();
+    const sharedTokens = [
+      "anterior",
+      "posterior",
+      "fundal",
+      "fundus",
+      "cervical",
+      "intramural",
+      "subserosal",
+      "submucosal",
+      "uterosacral",
+      "rectovaginal",
+      "pouch of douglas",
+      "left",
+      "right",
+    ].filter(
+      (tok) =>
+        (repLoc.includes(tok) || ef.sentence.text.toLowerCase().includes(tok)) &&
+        candLoc.includes(tok),
+    );
+    if (sharedTokens.length >= 2) {
+      score += 0.20;
+      reasons.push(`Anatomical location descriptors align (${sharedTokens.join(", ")})`);
+    } else if (sharedTokens.length === 1 || (repLat && candLat && repLat === candLat)) {
+      score += 0.15;
+      reasons.push(`Anatomical location/laterality aligns (${sharedTokens[0] ?? repLat})`);
+    } else {
+      score += 0.06;
+    }
+
+    // FIGO alignment (max +0.15)
+    if (repFigoNum != null && candFigoNum != null) {
+      if (repFigoNum === candFigoNum) {
+        score += 0.15;
+        reasons.push(`Exact FIGO ${repFigoNum} match`);
+      } else if (Math.abs(repFigoNum - candFigoNum) === 1) {
+        score += 0.08;
+        reasons.push(
+          `Adjacent FIGO class (report FIGO ${repFigoNum} vs candidate FIGO ${candFigoNum})`,
+        );
+      }
+    } else if (ef.structure !== "fibroid") {
+      score += 0.10;
+    } else {
+      score += 0.05;
+    }
+
+    // Same-dimension normalized measurement similarity (max +0.15)
+    // Never compare linear mm directly against volume mm3!
+    if (reportedLongestMm != null && cand.longestMm != null && cand.longestMm > 0) {
+      const diffMm = Math.abs(reportedLongestMm - cand.longestMm);
+      const relDiff = diffMm / Math.max(reportedLongestMm, cand.longestMm);
+      if (diffMm <= 3.0) {
+        score += 0.15;
+        reasons.push(
+          `Linear longest dimension closely matches (${reportedLongestMm.toFixed(1)} mm vs ${cand.longestMm.toFixed(1)} mm)`,
+        );
+      } else if (relDiff <= 0.25) {
+        score += 0.10;
+        reasons.push(
+          `Linear longest dimension within 25% (${reportedLongestMm.toFixed(1)} mm vs ${cand.longestMm.toFixed(1)} mm; Δ=${diffMm.toFixed(1)} mm)`,
+        );
+      } else {
+        score += 0.03;
+        reasons.push(
+          `Linear dimension discrepancy noted (${reportedLongestMm.toFixed(1)} mm in report vs ${cand.longestMm.toFixed(1)} mm on imaging)`,
+        );
+      }
+    } else if (
+      reportedLongestMm == null &&
+      reportedVolumeMm3 != null &&
+      cand.volumeMm3 != null &&
+      cand.volumeMm3 > 0
+    ) {
+      const relVolDiff =
+        Math.abs(reportedVolumeMm3 - cand.volumeMm3) /
+        Math.max(reportedVolumeMm3, cand.volumeMm3);
+      if (relVolDiff <= 0.20) {
+        score += 0.15;
+        reasons.push(
+          `Normalized volume closely matches (${(reportedVolumeMm3 / 1000).toFixed(1)} mL vs ${(cand.volumeMm3 / 1000).toFixed(1)} mL)`,
+        );
+      } else if (relVolDiff <= 0.40) {
+        score += 0.08;
+        reasons.push(
+          `Normalized volume comparable (${(reportedVolumeMm3 / 1000).toFixed(1)} mL vs ${(cand.volumeMm3 / 1000).toFixed(1)} mL)`,
+        );
+      }
+    } else {
+      score += 0.05;
+    }
+
+    if (ef.uncertain) {
+      score = Math.min(score, 0.68);
+      reasons.push("Report statement contains clinical uncertainty; downgraded for review");
+    }
+
+    const roundedScore = Number(Math.min(1, Math.max(0, score)).toFixed(2));
+    return {
+      findingId: cand.findingId,
+      findingCode: cand.findingCode,
+      findingVersionId: cand.findingVersionId,
+      versionNo: cand.versionNo,
+      studyId: cand.studyId,
+      observedOn: cand.observedOn,
+      organ: cand.organ,
+      structure: cand.structure,
+      locationLabel: cand.locationLabel,
+      laterality: candLat,
+      figo: cand.figo,
+      longestMm: cand.longestMm,
+      volumeMm3: cand.volumeMm3,
+      frame: cand.frame,
+      compatible: true,
+      score: roundedScore,
+      reasons,
+      incompatibilityReasons: [],
+      explanation: `${cand.findingCode} (${cand.locationLabel}, v${cand.versionNo}) scored ${(roundedScore * 100).toFixed(0)}%: ${reasons.join("; ")}.`,
+    };
+  });
