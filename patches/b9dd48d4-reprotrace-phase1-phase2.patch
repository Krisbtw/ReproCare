+    from reports r
+    join studies s on s.id = r.study_id
+    where r.id = ${reportId}
+  `;
+  if (!rRows[0]) throw new Error("Report not found.");
+  const { patientOwnerUserId } = await requirePatientRecordAccess(
+    sql,
+    userId,
+    rRows[0].patient_id,
+    "evaluate report candidate matches",
