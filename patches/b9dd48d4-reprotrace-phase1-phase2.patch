+      findingIndex,
+      structure: ef.structure,
+      organ: ef.organ,
+      laterality: ef.laterality,
+      anatomicalLocation: ef.anatomicalLocation ?? null,
+      figo: ef.figo,
+      reportedLongestMm,
+      reportedVolumeMm3,
+      dimensionKind,
+      candidateState: "no_suitable_candidate",
+      candidateStateLabel: CANDIDATE_STATE_LABELS.no_suitable_candidate,
+      suggestedFindingId: null,
+      suggestedVersionId: null,
