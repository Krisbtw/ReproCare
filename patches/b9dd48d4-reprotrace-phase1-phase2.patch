+  const repFigoNum = parsePrimaryFigoNumber(ef.figo);
+  const exactSameStudyFigoMatches = candidates.filter((c) => {
+    const cFigo = parsePrimaryFigoNumber(c.figo ?? c.locationLabel);
+    return (
+      c.patientId === patientId &&
+      reportStudyId &&
+      c.studyId === reportStudyId &&
+      repFigoNum != null &&
+      cFigo === repFigoNum
+    );
+  });
+
+  const scoredCandidates: CandidateFindingScore[] = candidates.map((cand) => {
+    const reasons: string[] = [];
+    const incompatibilityReasons: string[] = [];
+
+    // Hard gate 1: Patient identity
