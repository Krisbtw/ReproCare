+function extractLateralityFromText(text: string | null | undefined): "left" | "right" | "bilateral" | null {
+  if (!text) return null;
+  if (/\b(bilateral|both)\b/i.test(text)) return "bilateral";
+  const l = /\bleft\b/i.test(text);
+  const r = /\bright\b/i.test(text);
+  if (l && !r) return "left";
+  if (r && !l) return "right";
+  return null;
