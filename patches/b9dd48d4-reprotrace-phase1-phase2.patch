+/**
+ * Evaluate candidate matches for all extracted findings in a report against stored patient findings.
+ */
+export async function evaluateReportCandidateMatches(
+  sql: Sql,
+  ownerUserId: string,
+  patientId: string,
+  studyId: string | null,
+  extraction: Extraction,
+): Promise<ObservationCandidateEvaluation[]> {
+  const findings = await sql<{
+    id: string;
+    code: string;
+    patient_id: string;
+    structure: string;
+    organ: string;
+    pathway: string;
+  }>`
+    select id, code, patient_id, structure, organ, pathway
+    from findings
+    where patient_id = ${patientId} and user_id = ${ownerUserId}
+  `.catch(() => []);
+
+  const findingIds = new Set(findings.map((f) => f.id));
+  const allVersions = await sql<{
+    id: string;
+    finding_id: string;
+    version_no: number;
+    study_id: string;
+    observed_on: string;
+    location_label: string;
+    figo: string | null;
+    longest_mm: number | null;
+    axes_mm: string | null;
+    volume_mm3?: number | null;
+    frame: string;
+  }>`
+    select id, finding_id, version_no, study_id, observed_on::text as observed_on,
+           location_label, figo, longest_mm, axes_mm, frame
+    from finding_versions
+    where user_id = ${ownerUserId}
+    order by version_no desc
+  `.catch(() => []);
+
+  const studyVersions = studyId
+    ? allVersions.filter((v) => findingIds.has(v.finding_id) && v.study_id === studyId)
+    : [];
+  const candidatePool =
+    studyVersions.length > 0
+      ? studyVersions
+      : allVersions.filter((v) => findingIds.has(v.finding_id));
+
+  // Keep latest version per finding from candidatePool
+  const latestByFinding = new Map<string, (typeof allVersions)[number]>();
+  for (const v of candidatePool) {
+    if (!latestByFinding.has(v.finding_id)) {
+      latestByFinding.set(v.finding_id, v);
+    }
+  }
+
+  const candidateInputs: StoredCandidateInput[] = [];
+  for (const f of findings) {
+    const v = latestByFinding.get(f.id);
+    if (!v) continue;
+    let parsedAxes: [number, number, number] | null = null;
+    if (v.axes_mm) {
+      try {
+        const arr = JSON.parse(v.axes_mm);
+        if (Array.isArray(arr) && arr.length === 3) {
+          parsedAxes = [Number(arr[0]), Number(arr[1]), Number(arr[2])];
+        }
+      } catch {
+        parsedAxes = null;
+      }
+    }
+    const derivedVolMm3 =
+      v.volume_mm3 != null
+        ? Number(v.volume_mm3)
+        : parsedAxes
+          ? Math.round(
+              (4 / 3) *
+                Math.PI *
+                (parsedAxes[0] / 2) *
+                (parsedAxes[1] / 2) *
+                (parsedAxes[2] / 2),
+            )
+          : null;
+    candidateInputs.push({
+      findingId: f.id,
+      findingCode: f.code,
+      patientId: f.patient_id,
+      structure: f.structure,
+      organ: f.organ,
+      pathway: f.pathway,
+      findingVersionId: v.id,
+      versionNo: Number(v.version_no),
+      studyId: v.study_id,
+      observedOn: String(v.observed_on).slice(0, 10),
+      locationLabel: v.location_label,
+      figo: v.figo,
+      longestMm: v.longest_mm != null ? Number(v.longest_mm) : null,
+      axesMm: parsedAxes,
+      volumeMm3: derivedVolMm3,
+      frame: v.frame,
+    });
+  }
+
+  return (extraction.findings ?? []).map((ef, idx) =>
+    scoreCandidateFindingsForObservation({
+      patientId,
+      reportStudyId: studyId,
+      reportExamDate: extraction.examDate,
+      findingIndex: idx,
+      extractedFinding: ef,
+      measurements: extraction.measurements ?? [],
+      candidates: candidateInputs,
+    }),
+  );
+}
