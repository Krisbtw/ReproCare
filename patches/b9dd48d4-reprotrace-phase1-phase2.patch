+  );
+  const exRows = await sql<{ extraction: string }>`
+    select extraction from report_extractions where report_id = ${reportId} order by created_at desc limit 1
+  `.catch(() => []);
+  const extraction = exRows[0]?.extraction
+    ? (JSON.parse(exRows[0].extraction) as ReturnType<typeof extractReport>)
