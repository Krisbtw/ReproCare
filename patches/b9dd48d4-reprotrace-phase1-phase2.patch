+    quality: string;
+    modality: string;
+    created_at: string;
+  }>`
+    select id, finding_id, version_no, previous_version_id, study_id, observed_on::text as observed_on,
+           location_label, figo, centroid_mm, axes_mm, longest_mm, measurement_basis,
+           frame, segmentation_source, quality, modality, created_at::text as created_at
+    from finding_versions
+    where id = ${findingVersionId}
