+      structure: ef.structure,
+      organ: ef.organ,
+      laterality: ef.laterality,
+      anatomicalLocation: ef.anatomicalLocation ?? null,
+      figo: ef.figo,
+      reportedLongestMm,
+      reportedVolumeMm3,
+      dimensionKind,
+      candidateState: "insufficient_evidence",
+      candidateStateLabel: CANDIDATE_STATE_LABELS.insufficient_evidence,
+      suggestedFindingId: null,
+      suggestedVersionId: null,
+      requiresClinicianConfirmation: true,
+      summaryExplanation: `Statement is negated ("${ef.sentence.text}") and represents absence of a finding rather than a linkable anatomical lesion.`,
+      candidates: [],
+    };
+  }
+
+  if (!ef.structure || !ef.organ) {
+    return {
+      findingIndex,
+      structure: ef.structure || "unknown",
+      organ: ef.organ || "unknown",
+      laterality: ef.laterality,
+      anatomicalLocation: ef.anatomicalLocation ?? null,
+      figo: ef.figo,
+      reportedLongestMm,
+      reportedVolumeMm3,
+      dimensionKind,
+      candidateState: "insufficient_evidence",
+      candidateStateLabel: CANDIDATE_STATE_LABELS.insufficient_evidence,
+      suggestedFindingId: null,
+      suggestedVersionId: null,
+      requiresClinicianConfirmation: true,
