# ReproCare / AnatomyBridge Environment Configuration
# Copy to .env for local development. Never commit real production secrets to Git.

# 1. Supabase PostgreSQL Database (Server-side only — NEVER prefix with VITE_)
# For Vercel Serverless / Production runtime, use the Supabase Shared Transaction Pooler (port 6543)
# obtained from Supabase Dashboard -> Connect -> Transaction pooler:
DATABASE_URL=postgresql://postgres.mfbqdesghtvalkywzsdb:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# For controlled schema migrations (`npm run db:migrate`), use the direct connection (port 5432)
# or session pooler (port 5432):
DIRECT_DATABASE_URL=postgresql://postgres:vJihFnkCtLkADB20@db.mfbqdesghtvalkywzsdb.supabase.co:5432/postgres
SUPABASE_POOL_MODE=transaction
DATABASE_POOL_MAX=3

# 2. Supabase Storage (Server-side only — NEVER expose SUPABASE_SERVICE_ROLE_KEY in VITE_* or client code)
# Private medical buckets provisioned by `node scripts/setup-supabase-storage.mjs`:
#   - reprocare-imaging (DICOM files, studies, NIfTI volumes)
#   - reprocare-reports (clinical PDF reports, supporting documents)
#   - reprocare-derived (segmentation masks, 3D meshes, derived volumes)
REPROCARE_STORAGE_BACKEND=supabase
SUPABASE_URL=https://mfbqdesghtvalkywzsdb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]

# Local fallback directories (used only when REPROCARE_STORAGE_BACKEND=local_durable in local dev/tests)
REPROCARE_IMAGING_STORAGE_DIR=.data/imaging
REPROCARE_IMAGING_BACKUP_DIR=.data/imaging-backups

# 3. Python Imaging Service Integration (Server-side only — NEVER prefix with VITE_)
# On Vercel Multi-Service deployments, ANATOMYBRIDGE_SERVICE_URL is auto-injected by the service binding.
ANATOMYBRIDGE_SERVICE_URL=http://localhost:8100
ANATOMYBRIDGE_SERVICE_API_KEY=[YOUR-32-BYTE-RANDOM-SERVICE-API-KEY]

# 4. Python Imaging Service Runtime Settings (imaging-service/)
ANATOMYBRIDGE_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ANATOMYBRIDGE_UMD_WEIGHTS=/var/lib/reprocare/models/umd_unet3d.pt
ANATOMYBRIDGE_UMD_DEVICE=cpu

# 5. Clinical Report LLM Mode (Defaults to safe zero-network local_extractive)
REPROCARE_LLM_MODE=local_extractive
REPROCARE_LLM_EXTERNAL_PRIVACY_APPROVED=false

# 6. Better Auth & First Admin Bootstrap
BETTER_AUTH_URL=http://localhost:8080
BOOTSTRAP_ADMIN_EMAILS=admin@reprocare.org

# 7. Web Server Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
VITE_AUTH_ENABLED=true
