# ReproCare Environment Configuration

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://reprocare:password@localhost:5432/reprocare_db

# Imaging Service Integration (Server-side proxy settings - NOT VITE_ prefixed for security)
ANATOMYBRIDGE_SERVICE_URL=http://localhost:8100
ANATOMYBRIDGE_SERVICE_API_KEY=your_imaging_service_secret_key

# Imaging Service Environment (for imaging-service/)
ANATOMYBRIDGE_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ANATOMYBRIDGE_UMD_WEIGHTS=/path/to/umd_unet_weights.pt
ANATOMYBRIDGE_UMD_DEVICE=cpu

# First Admin Bootstrap (comma-separated list of email addresses automatically granted admin role on sign-in)
BOOTSTRAP_ADMIN_EMAILS=admin@reprocare.org

# Storage path for persistent medical imaging (local filesystem directory or S3 bucket)
IMAGING_STORAGE_PATH=.data/imaging

# Application Environment
NODE_ENV=development
VITE_AUTH_ENABLED=true
