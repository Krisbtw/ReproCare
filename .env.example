# ReproCare / AnatomyBridge Environment Configuration
# Copy to .env for local development. Never commit real production secrets to Git.

# 1. Database (PostgreSQL 15+ in production/Docker; PGlite fallback when unset in local preview)
DATABASE_URL=postgresql://reprocare:password@localhost:5432/reprocare_db
DB_USER=reprocare
DB_PASSWORD=change_me_in_production
DB_NAME=reprocare_db

# 2. Python Imaging Service Integration (Server-side only — NEVER prefix with VITE_)
ANATOMYBRIDGE_SERVICE_URL=http://localhost:8100
ANATOMYBRIDGE_SERVICE_API_KEY=change_me_to_32_byte_random_secret_in_production

# 3. Python Imaging Service Runtime Settings (imaging-service/)
ANATOMYBRIDGE_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ANATOMYBRIDGE_UMD_WEIGHTS=/var/lib/reprocare/models/umd_unet3d.pt
ANATOMYBRIDGE_UMD_DEVICE=cpu

# 4. Persistent Medical Imaging Storage & Backups (Server-side only)
REPROCARE_STORAGE_BACKEND=local_durable
REPROCARE_IMAGING_STORAGE_DIR=/var/lib/reprocare/imaging
REPROCARE_IMAGING_BACKUP_DIR=/var/lib/reprocare/backups

# 5. Clinical Report LLM Mode (Defaults to safe zero-network local_extractive)
REPROCARE_LLM_MODE=local_extractive
REPROCARE_LLM_EXTERNAL_PRIVACY_APPROVED=false

# 6. First Admin Bootstrap (Comma-separated list of emails granted admin role on sign-in)
BOOTSTRAP_ADMIN_EMAILS=admin@reprocare.org

# 7. Web Server Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
VITE_AUTH_ENABLED=true
