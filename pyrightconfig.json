{
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": [
    "imaging-service",
    "imaging-service/app"
  ],
  "include": [
    "imaging-service"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".vercel",
    ".venv"
  ],
  "typeCheckingMode": "off",
  "reportMissingImports": "none",
  "reportMissingTypeStubs": false
}
